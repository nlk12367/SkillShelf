{
  "schemaVersion": 1,
  "skillRoots": [
    "~/.codex/skills",
    "~/.agents/skills",
    "~/.claude/skills",
    "~/.cursor/skills",
    "~/.config/opencode/skills",
    "./.codex/skills",
    "./.agents/skills",
    "./.claude/skills"
  ],
  "pluginCaches": [
    "~/.codex/plugins/cache",
    "~/.claude/plugins/cache"
  ],
  "includeAuxiliary": false,
  "scanLimits": {
    "maxSkillBytes": 1048576,
    "maxTotalBytes": 67108864,
    "maxFiles": 10000,
    "maxEntries": 100000,
    "maxDepth": 16
  },
  "excludeDirectories": []
}
